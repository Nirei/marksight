msgstr[0] "ಕಡತ ಬಹಳ ದೊಡ್ಡದಾಗಿದೆ: {size} ಬೈಟ್ (ಮಿತಿ {limit} ಬೈಟ್‌ಗಳು)"
msgstr[1] "ಕಡತ ಬಹಳ ದೊಡ್ಡದಾಗಿದೆ: {size} ಬೈಟ್‌ಗಳು (ಮಿತಿ {limit} ಬೈಟ್‌ಗಳು)"

#: src/app/loading.rs:155
msgid "file not found"
