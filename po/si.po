#: src/app/loading.rs:130
msgid "not a regular file"
msgstr "සාමාන්‍ය ගොනුවක් නොවේ"

#: src/app/loading.rs:135
msgid "file too large: {size} byte (the limit is {limit} bytes)"
msgid_plural "file too large: {size} bytes (the limit is {limit} bytes)"
msgstr[0] "ගොනුව ඉතා විශාලයි: බයිට් {size} (සීමාව: බයිට් {limit})"
msgstr[1] "ගොනුව ඉතා විශාලයි: බයිට් {size} (සීමාව: බයිට් {limit})"

#: src/app/loading.rs:155
msgid "file not found"
msgstr "ගොනුව හමු නොවීය"

#: src/app/loading.rs:156
msgid "permission denied"
msgstr "අවසරය ප්‍රතික්ෂේප විය"

#: src/app/loading.rs:334
msgid "(untitled heading)"
msgstr "(නම් නොකළ ශීර්ෂය)"

#: src/app/loading.rs:339
msgid "Jump to {heading}"
msgstr "{heading} වෙත පනින්න"

#: src/app/search.rs:101
msgid "{position} of {total} match"
msgid_plural "{position} of {total} matches"
msgstr[0] "{total} න් {position} වන ගැළපුම"
msgstr[1] "{total} න් {position} වන ගැළපුම්"

#: src/app/window.rs:157
msgid "Open a markdown file (Ctrl+O)"
msgstr "Markdown ගොනුවක් විවෘත කරන්න (Ctrl+O)"

#: src/app/window.rs:159
msgid "Open markdown file"
msgstr "Markdown ගොනුව විවෘත කරන්න"

#: src/app/window.rs:162
msgid "Contents"
msgstr "පටුන"

#: src/app/window.rs:163
msgid "Toggle the table of contents (F9)"
msgstr "පටුන පෙන්වන්න හෝ සඟවන්න (F9)"

#: src/app/window.rs:167
msgid "About marksight"
msgstr "marksight පිළිබඳ"

#: src/app/window.rs:168
msgid "Quit"
msgstr "පිටවෙන්න"

#: src/app/window.rs:176
msgid "Open the main menu"
msgstr "ප්‍රධාන වට්ටෝරුව විවෘත කරන්න"

#: src/app/window.rs:177
msgid "Main menu"
msgstr "ප්‍රධාන වට්ටෝරුව"

#: src/app/window.rs:239
msgid "Find in document"
msgstr "ලේඛනය තුළ සොයන්න"

#: src/app/window.rs:503
msgid "A minimal, theme-native markdown viewer"
msgstr "තේමාවට ගැළපෙන, සරල Markdown දර්ශකයකි"

#: src/app/window.rs:521
msgid "Open a Markdown file to view it here"
msgstr "මෙහි බැලීම සඳහා Markdown ගොනුවක් විවෘත කරන්න"

#: src/app/window.rs:523
msgid "Open a file…"
msgstr "ගොනුවක් විවෘත කරන්න…"

#: src/app/window.rs:527
msgid "Ctrl+O open · F9 contents · Ctrl+F find · live reload on save"
msgstr "Ctrl+O විවෘත කරන්න · F9 පටුන · Ctrl+F සොයන්න · සුරැකූ විගස නැවත පූරණය වේ"

#: src/app/window.rs:541
msgid "Could not open file"
msgstr "ගොනුව විවෘත කළ නොහැක"

#: src/app/window.rs:547
msgid "Open another file…"
msgstr "වෙනත් ගොනුවක් විවෘත කරන්න…"

#: src/render.rs:345
msgid "Footnotes"
msgstr "පාදක සටහන්"

#: src/render.rs:582
msgid "Note"
msgstr "සටහන"

#: src/render.rs:583
msgid "Tip"
msgstr "ඉඟිය"

#: src/render.rs:584
msgid "Important"
msgstr "වැදගත්"

#: src/render.rs:585
msgid "Warning"
msgstr "අවවාදය"

#: src/render.rs:586
msgid "Caution"
msgstr "ප්‍රවේශම්"

#: src/render.rs:703
msgid "🖼 {alt}: {url}"
msgstr "🖼 {alt}: {url}"
