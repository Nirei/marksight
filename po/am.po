msgstr[0] "ፋይሉ በጣም ትልቅ ነው: {size} ባይት (ገደቡ {limit} ባይት ነው)"
msgstr[1] "ፋይሉ በጣም ትልቅ ነው: {size} ባይት (ገደቡ {limit} ባይት ነው)"

#: src/app/loading.rs:155
msgid "file not found"
msgstr "ፋይል አልተገኘም"

#: src/app/loading.rs:156
msgid "permission denied"
msgstr "ፈቃድ ተከልክሏል"

#: src/app/loading.rs:334
msgid "(untitled heading)"
