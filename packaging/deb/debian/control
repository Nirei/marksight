# Built with the cargo available in PATH (rustup locally, distro cargo on
# buildds); Mint/Ubuntu 24.04's rustc 1.75 is too old for edition 2024, so
# dh-cargo's hardcoded /usr/share/cargo/bin/cargo is deliberately not used.
Build-Depends:
 debhelper-compat (= 13),
 libgtk-4-dev (>= 4.10),
Standards-Version: 4.7.0
Vcs-Git: https://github.com/cinzatech/marksight.git
Vcs-Browser: https://github.com/cinzatech/marksight
