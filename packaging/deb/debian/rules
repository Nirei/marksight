#!/usr/bin/make -f

%:
	dh $@ --buildsystem cargo

override_dh_auto_install:
	dh_auto_install
	install -Dm644 data/io.github.marksight.Marksight.desktop \
		debian/marksight/usr/share/applications/io.github.marksight.Marksight.desktop
	install -Dm644 data/io.github.marksight.Marksight.metainfo.xml \
		debian/marksight/usr/share/metainfo/io.github.marksight.Marksight.metainfo.xml
	install -Dm644 data/icons/hicolor/scalable/apps/io.github.marksight.Marksight.svg \
		debian/marksight/usr/share/icons/hicolor/scalable/apps/io.github.marksight.Marksight.svg
	install -Dm644 data/marksight.1 \
		debian/marksight/usr/share/man/man1/marksight.1
