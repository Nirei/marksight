#!/usr/bin/make -f

%:
	dh $@ --buildsystem cargo

override_dh_auto_install:
	dh_auto_install
	install -Dm644 data/io.github.markview.Markview.desktop \
		debian/markview/usr/share/applications/io.github.markview.Markview.desktop
	install -Dm644 data/io.github.markview.Markview.metainfo.xml \
		debian/markview/usr/share/metainfo/io.github.markview.Markview.metainfo.xml
	install -Dm644 data/icons/hicolor/scalable/apps/io.github.markview.Markview.svg \
		debian/markview/usr/share/icons/hicolor/scalable/apps/io.github.markview.Markview.svg
	install -Dm644 data/markview.1 \
		debian/markview/usr/share/man/man1/markview.1
