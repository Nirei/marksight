#!/usr/bin/make -f

CARGO ?= $(shell cat debian/cargo.path 2>/dev/null || command -v cargo 2>/dev/null || echo cargo)
export PATH := $(dir $(CARGO)):$(PATH)

%:
	dh $@

override_dh_auto_clean:
	$(CARGO) clean

override_dh_auto_build:
	$(CARGO) build --release --locked

override_dh_auto_test:
	$(CARGO) test --release --locked --lib --test snapshots --test property --test cli

override_dh_auto_install:
	install -Dm755 target/release/marksight debian/marksight/usr/bin/marksight
	install -Dm644 data/io.github.cinzatech.marksight.desktop debian/marksight/usr/share/applications/io.github.cinzatech.marksight.desktop
	install -Dm644 data/io.github.cinzatech.marksight.metainfo.xml debian/marksight/usr/share/metainfo/io.github.cinzatech.marksight.metainfo.xml
	install -Dm644 data/icons/hicolor/scalable/apps/io.github.cinzatech.marksight.svg debian/marksight/usr/share/icons/hicolor/scalable/apps/io.github.cinzatech.marksight.svg
	install -Dm644 data/marksight.1 debian/marksight/usr/share/man/man1/marksight.1
	for po in po/*.po; do \
		test -f "$$po" || continue; \
		install -d debian/marksight/usr/share/locale/$$(basename $${po} .po)/LC_MESSAGES; \
		msgfmt -o debian/marksight/usr/share/locale/$$(basename $${po} .po)/LC_MESSAGES/marksight.mo $${po}; \
	done
